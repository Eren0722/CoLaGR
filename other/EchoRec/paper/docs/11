import matplotlib.pyplot as plt
import matplotlib.patches as patches

# 设置全局字体大小
plt.rcParams.update({'font.size': 12, 'font.family': 'sans-serif'})

fig, ax = plt.subplots(figsize=(14, 5))
ax.axis('off') # 隐藏坐标轴

# 定义画卡片的辅助函数
def draw_card(ax, x, y, width, height, text, facecolor, edgecolor, textcolor='black'):
    rect = patches.FancyBboxPatch((x, y), width, height, boxstyle="round,pad=0.1", 
                                  linewidth=1.5, edgecolor=edgecolor, facecolor=facecolor)
    ax.add_patch(rect)
    ax.text(x + width/2, y + height/2, text, ha='center', va='center', 
            color=textcolor, fontsize=11, fontweight='bold')

# === 颜色定义 ===
c_anchor_edge = '#1f4e79'  # 深蓝
c_anchor_face = '#f8f9fa'  
c_sem_face = '#e6f0fa'     # 浅蓝
c_sem_edge = '#8faadc'    
c_raw_1 = '#fdebea'        # 浅红
c_raw_2 = '#fdf5e6'        # 浅棕
c_raw_3 = '#f0f0f0'        # 浅灰
c_text_alert = '#c00000'   # 深红警告色

# === Panel (a) Query Sequence ===
ax.text(1.5, 3.8, "(a) Anchor User Sequence", ha='center', fontsize=14, fontweight='bold')
draw_card(ax, 0.5, 2.5, 2, 0.6, "The Matrix", c_anchor_face, c_anchor_edge)
draw_card(ax, 0.5, 1.5, 2, 0.6, "Inception", c_anchor_face, c_anchor_edge)
draw_card(ax, 0.5, 0.5, 2, 0.6, "Interstellar", c_anchor_face, c_anchor_edge)

# 背景虚线框 (Anchor)
anchor_box = patches.Rectangle((0.2, 0.2), 2.6, 3.2, linewidth=2, edgecolor='#5b9bd5', facecolor='none', linestyle='--')
ax.add_patch(anchor_box)

# === Panel (b) Frozen Semantic Neighborhood ===
ax.text(6.5, 3.8, "(b) Frozen Semantic Space", ha='center', fontsize=14, fontweight='bold')
ax.text(6.5, 3.5, "coherent local neighbors", ha='center', fontsize=10, color='gray', style='italic')

draw_card(ax, 4.5, 2.5, 4, 0.6, "Arrival / Blade Runner", c_sem_face, c_sem_edge)
draw_card(ax, 4.5, 1.5, 4, 0.6, "Gravity / The Martian", c_sem_face, c_sem_edge)
draw_card(ax, 4.5, 0.5, 4, 0.6, "Tenet / Minority Report", c_sem_face, c_sem_edge)

# 注释：语义一致性
ax.text(6.5, -0.2, "✓ Semantic Consistency", ha='center', fontsize=12, fontweight='bold', color='#2e75b6')

# === Panel (c) Raw Sequential Neighborhood ===
ax.text(12, 3.8, "(c) Raw Sequential Space", ha='center', fontsize=14, fontweight='bold')
ax.text(12, 3.5, "fragmented & mismatched neighbors", ha='center', fontsize=10, color='gray', style='italic')

# 故意排列错位、颜色混杂
draw_card(ax, 10.0, 2.6, 3.8, 0.6, "Interstellar / Baby Toys", c_raw_1, 'gray')
draw_card(ax, 10.5, 1.5, 3.5, 0.6, "Inception / Phone Case", c_raw_2, 'gray')
draw_card(ax, 9.8, 0.4, 4.2, 0.6, "Dune / Kitchen Set / Charger", c_raw_3, 'gray')

# 注释：拓扑碎片化
ax.text(12, -0.2, "✗ Topological Fragmentation", ha='center', fontsize=12, fontweight='bold', color=c_text_alert)
ax.text(12, -0.6, "✗ Local Metric Mismatch", ha='center', fontsize=12, fontweight='bold', color=c_text_alert)

# === 跨空间箭头 (SSHG 隐喻) ===
# 箭头 1：Anchor to Semantic
ax.annotate('', xy=(4.3, 1.8), xytext=(2.9, 1.8),
            arrowprops=dict(arrowstyle="->", color='#5b9bd5', lw=2))
ax.text(3.6, 1.9, "k-NN", ha='center', fontsize=10, color='#5b9bd5')

# 箭头 2：Anchor to Raw
ax.annotate('', xy=(9.6, 1.8), xytext=(8.7, 1.8),
            arrowprops=dict(arrowstyle="->", color='gray', lw=2))
ax.text(9.15, 1.9, "k-NN", ha='center', fontsize=10, color='gray')

# 模态鸿沟标记 (SSHG)
ax.annotate('', xy=(8.5, 4.2), xytext=(6.5, 4.2),
            arrowprops=dict(arrowstyle="<->", color=c_text_alert, lw=2, linestyle='--'))
ax.text(7.5, 4.3, "SSHG (Modality Gap)", ha='center', fontsize=12, fontweight='bold', color=c_text_alert)

plt.xlim(0, 14.5)
plt.ylim(-1, 4.5)
plt.tight_layout()
plt.savefig("intro_sshg_motivation.pdf", format='pdf', bbox_inches='tight')
plt.show()